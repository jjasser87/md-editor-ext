{
  "manifest_version": 3,
  "name": "Markdown WYSIWYG Editor",
  "version": "0.1.0",
  "description": "Open, edit and save Markdown files in a WYSIWYG editor.",
  "action": { "default_title": "Open Markdown Editor", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" } },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "content_scripts": [
    { "matches": ["file:///*.md", "file:///*.markdown"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
